# Copy these values into the production host's secret environment. Never commit
# the populated file. Prefer Docker secrets or a root-readable env file.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://assets.heliar.top
ASSET_MANIFEST_ENABLED=false
CORS_ALLOWED_ORIGINS=https://heliar.top,https://www.heliar.top

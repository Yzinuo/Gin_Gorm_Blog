server{
    listen 80; 
    server_name ${SERVER_NAME};
    root /usr/share/nginx/html;
    
    ############反向代理 start#######
    location = /api/article/import/feishu {
        proxy_pass http://${BACKEND_HOST}:${SERVER_PORT};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 110M;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }
    location /api {
        proxy_pass http://${BACKEND_HOST}:${SERVER_PORT};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        client_max_body_size 64M;
    }
    location /public/uploaded {
        proxy_pass http://${BACKEND_HOST}:${SERVER_PORT}/public/uploaded;
    }
    location /admin/public/uploaded{
        proxy_pass http://${BACKEND_HOST}:${SERVER_PORT}/public/uploaded;
    }
    ###################反向代理end#####

    #########静态资源#####
    location /{
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }
    location /admin{
        root /usr/share/nginx/html;
        try_files $uri $uri/ /admin/index.html;
        add_header Cache-Control "no-cache" always;
    }

    location ~* ^/(?:assets|admin/assets)/.*\.(?:js|css|woff2?|ttf|svg)$ {
        gzip on;
        gzip_static on; 
        gzip_min_length 1k;
        gzip_http_version 1.1;
        gzip_comp_level 9;
        gzip_types text/css application/javascript application/json;
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
}
